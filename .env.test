# Isolated test environment — NEVER points at dev.db and NEVER carries a real secret.
# Committed to git deliberately (unlike .env) so CI can run the test suite without
# any manual secret setup. Every value here is a disposable fixture, not a credential.

DATABASE_URL="file:./prisma/test.db"

ADMIN_EMAIL="test-admin@example.com"
ADMIN_PASSWORD="TestPassword123!"
# Generated solely for signing test-run session cookies. Not used anywhere outside
# the test database/server — never reuse this value for a real environment.
SESSION_SECRET="9b093a9f79c3232508405d7b836dd8a52c5ba864b58110759e62d35b2e458b20"

# Deliberately left as placeholders — Stage 3 tests must never touch real Stripe.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Separate port from the normal dev server (3000) so E2E runs never collide with
# a developer's own `npm run dev` session.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
PORT="3100"
