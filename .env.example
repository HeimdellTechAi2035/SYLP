# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real secrets.

# --- Database (infrastructure only — never edited directly, see README) ---
DATABASE_URL="file:./dev.db"

# --- Admin auth ---
# Used once by `npm run db:seed` to create the first admin login.
# Change the password immediately after first login via /admin/settings.
ADMIN_EMAIL="owner@handmadebymia.co.uk"
ADMIN_PASSWORD="ChangeMe123!"
# Long random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
