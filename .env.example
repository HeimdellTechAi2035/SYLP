# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real secrets.

# --- Database ---
# Postgres via Netlify DB. Locally, run everything through `netlify dev` (or
# `npm run dev`, which now wraps it) — it injects a working connection
# automatically, so DATABASE_URL below is only a fallback for contexts
# `netlify dev` doesn't reach (e.g. running a script with `node` directly).
DATABASE_URL="postgres://user:password@host:5432/dbname"

# --- Admin auth ---
# Used once by `npm run db:seed` to create the first admin login.
# Change the password immediately after first login via /admin/settings.
ADMIN_EMAIL="admin@support-your-local-patriot.online"
ADMIN_PASSWORD="ChangeMe123!"
# Long random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin order-notification email (Resend-compatible transactional API) ---
# Without these, the admin new-paid-order email records itself as FAILED
# with a clear "not configured" reason instead of pretending to send.
EMAIL_API_KEY="re_..."
EMAIL_FROM_ADDRESS="orders@yourdomain.example"
EMAIL_FROM_NAME="Patriot Platform Online Store"

# --- Admin order-notification push (Web Push / VAPID — no SMS provider) ---
# Generate a keypair with: npx web-push generate-vapid-keys
# The public key is safe to expose client-side; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@support-your-local-patriot.online"
