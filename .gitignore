# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.swp
*~

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# tests
/test-results/
/playwright-report/
/blob-report/
.last-run.json

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env.test holds only disposable test fixtures (no real secrets) — committed
# deliberately so CI can run the suite without manual setup. See TESTING.md.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (dev SQLite file — never commit real business data)
# DATABASE_URL="file:./dev.db" resolves relative to the process cwd (project root),
# not to prisma/, so the live db file actually lands at the repo root — ignore both locations.
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# admin-uploaded media (local dev only — use cloud storage in production)
/public/uploads/*
!/public/uploads/.gitkeep

# local tooling state
/.claude/

# Local Netlify folder
.netlify

# Netlify Edge Functions tooling state (Deno lockfile, regenerated by netlify dev)
deno.lock

# Raw source images kept only for reference while producing a processed
# asset elsewhere (e.g. public/brand/logo.jpg) — not used by the app itself.
/Screenshot_20260906_121245_Instagram.jpg
/962426440_1788868617218499.jpg
