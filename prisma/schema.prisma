// Preston Patriot — data model
//
// Postgres, provisioned via Netlify DB (Neon-backed) — see lib/prisma.ts for
// how the connection string is resolved (Netlify's injected env locally via
// `netlify dev` / at build+runtime once deployed, DATABASE_URL otherwise).
// Status/type fields below are still plain String columns with the allowed
// values documented in a comment and enforced in code (lib/validation) —
// carried over unchanged from the original SQLite schema rather than
// introduced now, so this migration doesn't also change validation behaviour.
//
// Catalogue rebuilt for a general merch line (apparel, drinkware, accessories,
// stationery, homeware, gift sets) — see migration
// 20260908000000_merch_catalog_rebuild. The old Fragrance model and the
// candle/wax-melt-specific Product fields it and the melt/burn instructions
// used are gone; Product now carries generic `material`/`careInstructions`
// fields instead, and ProductVariant's size/colour/packSize cover apparel and
// pack-based items alike.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ADMIN / AUTH
// ---------------------------------------------------------------------------

model AdminUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               String   @default("OWNER") // OWNER | STAFF
  // Set on a freshly-seeded/reset admin account; forces a password change
  // (enforced in middleware.ts, cleared by changeAdminPassword) before any
  // other admin page is usable, so a shared/known initial password can never
  // stay live past first login.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  auditLogs          AuditLog[]
  pushSubscriptions  AdminPushSubscription[]
}

// A registered browser/device that should receive Web Push order alerts.
// Deliberately tied to an AdminUser, never to a customer session — see
// requireAdminSession() calls in lib/actions/admin/push-subscriptions.ts.
model AdminPushSubscription {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  endpoint    String   @unique
  p256dh      String
  auth        String
  label       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastSuccessfulNotificationAt DateTime?
  notifications OrderNotification[]
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String    // e.g. "product.update", "order.status_change"
  entityType  String
  entityId    String?
  detail      String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// CATALOGUE STRUCTURE
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  sku         String   @unique
  name        String
  status      String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  productType String   @default("APPAREL") // APPAREL | ACCESSORY | DRINKWARE | STATIONERY | HOMEWARE | GIFT_SET | OTHER

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  shortDescription String?
  description      String?

  // Pricing — stored in pence (GBP) to avoid float rounding errors
  price       Int
  salePrice   Int?
  costPrice   Int?     // internal only — never serialized to any public API response
  saleActive  Boolean  @default(false)

  // Stock
  stockQuantity        Int     @default(0)
  lowStockThreshold    Int     @default(5)
  continueSellingOOS   Boolean @default(false)
  madeToOrder          Boolean @default(false)
  productionTimeDays   Int?

  // Internal fulfilment cost — independent of inventory mode; a made-to-order
  // product still gets packed and posted like any other. Variants may
  // override this; see ProductVariant.packagingProfileId.
  packagingProfileId String?
  packagingProfile   PackagingProfile? @relation(fields: [packagingProfileId], references: [id], onDelete: SetNull)

  // Media
  mainImage   String?
  videoUrl    String?
  images      ProductImage[]

  // Material / general product info
  material        String? // e.g. "100% cotton", "stainless steel", "PU leather"
  careInstructions String? // e.g. "Machine wash cold, do not tumble dry"
  netWeightGrams  Int?
  dimensions      String?

  // Compliance / safety (configurable per product — never assumed identical across products)
  safetyWarnings              String?
  supplierManufacturerDetails String?
  batchReference              String?
  safetyDocumentUrl           String?

  // Merchandising
  featured    Boolean @default(false)
  bestSeller  Boolean @default(false)
  isNew       Boolean @default(false)
  seasonal    Boolean @default(false)
  giftable    Boolean @default(false)

  // Gift sets
  giftPackagingAvailable Boolean @default(false)
  giftMessageEnabled     Boolean @default(false)
  giftSetItems           GiftSetItem[] @relation("GiftSetParent")

  // SEO
  seoTitle         String?
  metaDescription  String?
  socialImage      String?
  canonicalUrl     String?

  // Payments — Stripe catalogue mirror (Stripe is a downstream payment
  // catalogue here, never the source of truth for price/stock/availability).
  // stripePriceId is the Stripe Price for the regular `price`; stripeSalePriceId
  // (created lazily) is the Stripe Price for `salePrice`, when one is set.
  // Only used for products with no variant override — see lib/pricing.ts and
  // lib/stripe-sync.ts for exactly how a variant's own priceOverride changes this.
  stripeProductId   String?
  stripePriceId     String?
  stripeSalePriceId String?
  stripeSyncedAt    DateTime?
  stripeSyncStatus  String    @default("NOT_SYNCED") // NOT_SYNCED | PENDING | SYNCED | FAILED
  stripeSyncError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants        ProductVariant[]
  batches         ProductionBatch[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  relatedFrom     ProductRelation[] @relation("RelationFrom")
  relatedTo       ProductRelation[] @relation("RelationTo")
  usedInGiftSets  GiftSetItem[]     @relation("GiftSetComponent")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   // display label, e.g. "Preston Patriot Hoodie — Large / Black"
  size          String?
  colour        String?
  packSize      String?
  isGiftOption  Boolean  @default(false)
  sku           String   @unique
  priceOverride Int?
  stockQuantity Int      @default(0)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  // Overrides the parent Product's packaging profile when set — e.g. a
  // large gift-set variant that needs bigger packaging than its siblings.
  packagingProfileId String?
  packagingProfile   PackagingProfile? @relation(fields: [packagingProfileId], references: [id], onDelete: SetNull)

  // Only ever set for a variant with its own priceOverride — a variant that
  // inherits the product's price/sale has no distinct Stripe Price of its own
  // (it reuses the parent Product's stripePriceId / stripeSalePriceId).
  stripePriceId String?

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model ProductRelation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product @relation("RelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)
  type             String  @default("RELATED") // RELATED | FREQUENTLY_BOUGHT | CROSS_SELL
}

model GiftSetItem {
  id              String  @id @default(cuid())
  giftSetId       String
  giftSet         Product @relation("GiftSetParent", fields: [giftSetId], references: [id], onDelete: Cascade)
  componentId     String
  component       Product @relation("GiftSetComponent", fields: [componentId], references: [id], onDelete: Cascade)
  quantity        Int     @default(1)
}

model ProductionBatch {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dateMade          DateTime @default(now())
  quantityProduced  Int
  materialReference String?
  notes             String?
  status            String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETE
  createdAt         DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  firstName    String?
  lastName     String?
  phone        String?
  passwordHash String?   // null for guest-checkout-only customers
  createdAt    DateTime  @default(now())
  addresses    Address[]
  orders       Order[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  county     String?
  postcode   String
  country    String   @default("United Kingdom")
  isDefault  Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// CART / ORDERS
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int      @default(1)
  giftMessage String?
  createdAt DateTime @default(now())
}

// Single-row atomic counter backing human-readable HM-xxxx order numbers.
// Not row-count-derived (see lib/order-number.ts) — deleting an Order can
// never cause a number to be reused, and concurrent checkouts can never be
// allocated the same number.
model OrderSequence {
  id    Int @id @default(1)
  value Int @default(1000)
}

model Order {
  id                    String   @id @default(cuid())
  orderNumber           String   @unique
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  email       String
  firstName   String
  lastName    String
  phone       String?

  shippingLine1    String
  shippingLine2    String?
  shippingCity     String
  shippingCounty   String?
  shippingPostcode String
  shippingCountry  String @default("United Kingdom")

  subtotal        Int
  discountCode    String?
  discountAmount  Int      @default(0)
  deliveryAmount  Int      @default(0)  // what the customer actually paid for delivery — £0 when free delivery applied
  deliveryMethodName String? // snapshot of the DeliveryZone.name used, e.g. "UK Standard" — for admin/email display only
  total           Int

  // Internal fulfilment cost snapshot — fixed at order creation and never
  // recalculated, so a later admin rate change can't rewrite history. Both
  // are independent of deliveryAmount: they still exist even when the
  // customer paid nothing for delivery (free-delivery threshold met).
  estimatedPostageCost Int @default(0)
  packagingCost        Int @default(0)

  paymentStatus     String  @default("PENDING")   // PENDING | PAID | FAILED | REFUNDED | PART_REFUNDED
  fulfilmentStatus  String  @default("NEW")        // NEW | PAID | MAKING | READY_TO_PACK | PACKED | DISPATCHED | DELIVERED | CANCELLED

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  trackingCarrier String?
  trackingNumber  String?
  trackingUrl     String?

  giftMessage    String?
  internalNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  reviews       Review[]
  notifications OrderNotification[]
}

// Tracks each attempted admin notification delivery (email or push) for a
// paid order, so a retried Stripe webhook can never resend a notification
// that already went out. The unique constraint below is the idempotency
// guard: EMAIL is keyed by (order, recipient email); PUSH is keyed by
// (order, subscription id stored as `recipient`) — see lib/notifications/.
model OrderNotification {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel            String    // EMAIL | PUSH
  event              String    @default("ORDER_PAID")
  recipient          String    // email address (EMAIL) or AdminPushSubscription.id (PUSH)
  pushSubscriptionId String?
  pushSubscription   AdminPushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)
  status             String    @default("PENDING") // PENDING | SENT | FAILED
  providerMessageId  String?
  attemptedAt        DateTime  @default(now())
  sentAt             DateTime?
  errorMessage       String?

  @@unique([orderId, channel, event, recipient])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshots at time of purchase — must not change if the product changes later
  productName   String
  variantLabel  String?
  sku           String?
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  giftMessage   String?
}

// ---------------------------------------------------------------------------
// DISCOUNTS
// ---------------------------------------------------------------------------

model Discount {
  id                String    @id @default(cuid())
  code              String    @unique
  type              String    // FIXED | PERCENTAGE
  value             Int       // pence if FIXED, whole percent (1-100) if PERCENTAGE
  minimumSpend      Int?
  maxUses           Int?
  perCustomerLimit  Int?
  timesUsed         Int       @default(0)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean   @default(true)
  categoryId        String?
  productId         String?
  createdAt         DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// REVIEWS
// ---------------------------------------------------------------------------

model Review {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  rating            Int
  title             String?
  body              String
  status            String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verifiedPurchase  Boolean  @default(false)
  merchantResponse  String?
  createdAt         DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SUPPORT / CONTENT
// ---------------------------------------------------------------------------

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  orderNumber String?
  category    String   // Product question | Sizing question | Order question | Delivery | Return | Refund | Damaged item | Complaint | Wholesale enquiry | Other
  message     String
  status      String   @default("NEW") // NEW | READ | RESPONDED
  createdAt   DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   // Products | Sizing | Materials & Care | Safety | Orders | Delivery | Returns | Payments | Gift Sets | Contact
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  unansweredQuestions UnansweredQuestion[]
}

// A normalized chatbot question the knowledge base couldn't confidently
// answer. Deliberately stores only the question text, never a full
// conversation transcript or any customer-identifying data — see
// lib/knowledge/chat.ts for how this is populated.
model UnansweredQuestion {
  id            String    @id @default(cuid())
  question      String    @unique
  askCount      Int       @default(1)
  lastAskedAt   DateTime  @default(now())
  resolvedFaqId String?
  resolvedFaq   FaqItem?  @relation(fields: [resolvedFaqId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
}

model Policy {
  id          String   @id @default(cuid())
  slug        String   @unique // terms | privacy | cookies | delivery | returns-refunds | cancellation | complaints | product-care | accessibility
  title       String
  body        String
  isDraft     Boolean  @default(true)
  lastUpdated DateTime @updatedAt
}

model HomepageFeature {
  id        String @id @default(cuid())
  section   String @default("WHY_SHOP") // WHY_SHOP | STORY_GALLERY
  icon      String?
  title     String
  body      String?
  image     String?
  sortOrder Int    @default(0)
}

model HomepageContent {
  id                    Int     @id @default(1)
  announcementBarText   String?
  heroTitle             String?
  heroSubtitle          String?
  heroImage             String?
  heroCtaPrimaryLabel   String?
  heroCtaPrimaryHref    String?
  heroCtaSecondaryLabel String?
  heroCtaSecondaryHref  String?
  storyTitle            String?
  storyBody             String?
  storyImage            String?
  giftSectionTitle      String?
  giftSectionBody       String?
  giftSectionImage      String?
  updatedAt             DateTime @updatedAt
}

model DeliveryZone {
  id             String   @id @default(cuid())
  name           String
  countries      String   // e.g. "United Kingdom" or "International"
  price          Int
  freeThreshold  Int?
  estimatedDays  String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  // What the store actually expects to pay the carrier when this zone's
  // method is used — independent of `price`, the amount charged to the
  // customer. Optional: a zone with no rate assigned yet just records no
  // internal postage cost, rather than guessing at one.
  postageRateId String?
  postageRate   PostageRate? @relation(fields: [postageRateId], references: [id], onDelete: SetNull)
}

// Reference data for what carrier services actually cost the store —
// never charged to the customer directly, and never invented by this codebase:
// the admin enters real rates via /admin/delivery. Weight fields are recorded
// for a future weight-based auto-selection; today a rate is picked explicitly
// per DeliveryZone.
model PostageRate {
  id             String  @id @default(cuid())
  name           String  // e.g. "Royal Mail Tracked 48"
  cost           Int     // pence
  minWeightGrams Int?
  maxWeightGrams Int?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  deliveryZones DeliveryZone[]
}

// A reusable internal packaging cost profile (box + protection + label/tape,
// or a single flat figure) assigned to a Product/Variant, then snapshotted
// once per Order — never summed per line item, since a multi-item order
// realistically still ships in one parcel.
model PackagingProfile {
  id          String  @id @default(cuid())
  name        String  // e.g. "Small Parcel"
  description String?
  cost        Int     // pence
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products  Product[]
  variants  ProductVariant[]
}

model SiteSettings {
  id                      Int      @id @default(1)
  businessName            String   @default("Preston Patriot")
  supportEmail            String?
  supportPhone            String?
  freeDeliveryThreshold   Int?     // pence; null = disabled
  standardDeliveryPrice   Int      @default(295)
  estimatedDispatchDays   String?  @default("1-3 working days")
  estimatedDeliveryDays   String?  @default("2-4 working days")
  instagramUrl            String?
  facebookUrl             String?
  tiktokUrl                String?
  gaMeasurementId         String?
  metaPixelId             String?
  maintenanceMode         Boolean  @default(false)

  // Admin new-paid-order notifications (separate from any customer-facing
  // transactional email). The address is entered here, never hardcoded.
  orderNotificationEmail        String?
  orderNotificationEmailEnabled Boolean @default(false)

  updatedAt               DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  source       String?
}
