{
  "name": "support-your-local-patriot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "netlify dev --command \"prisma migrate dev\"",
    "db:seed": "netlify dev --command \"npm run db:seed:inner\"",
    "db:seed:inner": "node --experimental-strip-types prisma/seed.ts",
    "db:studio": "netlify dev --command \"prisma studio\"",
    "db:reset": "netlify dev --command \"prisma migrate reset\""
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "@netlify/database": "^2.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-image-crop": "^11.1.2",
    "stripe": "^22.6.1",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
